      },
      "on-inverse": {
        "$description": "Text and icon color on inverse actions.",
        "$value": { "colorSpace": "srgb", "components": [0.972549, 0.972549, 0.972549], "hex": "#f8f8f8" },
        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": { "colorSpace": "srgb", "components": [0.066667, 0.07451, 0.082353], "hex": "#111315" } } } }
      },
      "scrollbar-thumb": {
        "$description": "Monochrome scrollbar thumb.",
        "$value": { "colorSpace": "srgb", "components": [0.109804, 0.109804, 0.117647], "alpha": 0.18 },
