        "$value": { "colorSpace": "srgb", "components": [0.090196, 0.090196, 0.098039], "hex": "#171719" },
        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": { "colorSpace": "srgb", "components": [0.945098, 0.952941, 0.956863], "hex": "#f1f3f4" } } } }
      },
      "inverse-hover": {
        "$description": "Primary action hover fill.",
        "$value": { "colorSpace": "srgb", "components": [0.14902, 0.14902, 0.160784], "hex": "#262629" },
