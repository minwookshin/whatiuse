      },
      "bg-flyout": {
        "$description": "Anchored temporary Flyout surface.",
        "$value": "{theme.surface.bg-overlay}",
        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": { "colorSpace": "srgb", "components": [0.14902, 0.14902, 0.160784], "hex": "#262629" } } } }
      },
      "bg-modal": {
        "$description": "Focus-trapping Modal surface.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": "{theme.surface.bg-overlay}" } } }
      },
      "bg-scrim": {
        "$description": "Modal and drawer background attenuation.",
