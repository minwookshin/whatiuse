        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.44 } } } }
      },
      "bg-code": {
        "$description": "Collapsed and expanded source-code surface.",
        "$value": { "colorSpace": "srgb", "components": [0.109804, 0.109804, 0.117647], "alpha": 0.02 },
        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.025 } } } }
      },
      "canvas": { "$value": "{theme.surface.bg-canvas}" },
      "sidebar": { "$value": "{theme.surface.bg-sidebar}" },
      "surface": { "$value": "{theme.surface.bg-surface}" },
      "control-surface": { "$value": "{theme.surface.bg-control}" },
      "elevated-surface": { "$value": "{theme.surface.bg-raised}" },
      "overlay-surface": { "$value": "{theme.surface.bg-overlay}" },
      "code-surface": { "$value": "{theme.surface.bg-code}" },
      "stage": { "$value": "{theme.surface.bg-stage}" },
      "subtle": { "$value": "{theme.surface.bg-subtle}" },
      "hover": {
        "$description": "Frequent pointer hover feedback.",
        "$value": { "colorSpace": "srgb", "components": [0.109804, 0.109804, 0.117647], "alpha": 0.048 },
        "$extensions": { "dev.whatiuse": { "modeValues": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.064 } } } }
      },
      "active": {
        "$description": "Pressed or actively manipulated fill.",
