{
  "name": "whatiuse",
  "version": "0.1.0-rc.43",
  "description": "React components I use for product interfaces.",
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "components",
    "shadcn",
    "tailwindcss",
    "accessibility",
    "interaction"
  ],
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/package",
    "public/r/*.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/package/index.js",
  "module": "./dist/package/index.js",
  "types": "./dist/package/types/components/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/types/components/ui/index.d.ts",
      "import": "./dist/package/index.js",
      "default": "./dist/package/index.js"
    },
    "./styles.css": {
      "types": "./dist/package/styles.d.ts",
      "default": "./dist/package/styles.css"
    },
    "./tokens": {
      "types": "./dist/package/types/tokens/generated.d.ts",
      "import": "./dist/package/tokens.js",
      "default": "./dist/package/tokens.js"
    },
    "./tokens.css": {
      "types": "./dist/package/styles.d.ts",
      "default": "./dist/package/tokens.css"
    },
    "./tailwind.css": {
      "types": "./dist/package/styles.d.ts",
      "default": "./dist/package/tailwind.css"
    },
    "./tokens.json": "./dist/package/tokens.json",
    "./registry/*": "./public/r/*.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && npm run check:api && npm run check:agent && npm run check:adoption && npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "diff:tokens": "node scripts/diff-tokens.mjs",
    "check:foundations": "node scripts/verify-foundations.mjs",
    "build:api": "node scripts/build-api.mjs",
    "check:api": "node scripts/build-api.mjs --check",
    "build:agent": "node scripts/build-agent-contract.mjs",
    "check:agent": "node scripts/build-agent-contract.mjs --check",
    "build:freeze": "node scripts/build-release-freeze.mjs",
    "check:freeze": "node scripts/build-release-freeze.mjs --check",
    "build:evidence": "node scripts/build-evidence.mjs",
    "check:evidence": "node scripts/build-evidence.mjs --check",
    "build:brand-assets": "node scripts/build-brand-assets.mjs",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "test:stories": "node scripts/run-storybook-tests.mjs",
    "test:stories:light": "node scripts/run-storybook-tests.mjs light",
    "test:stories:dark": "node scripts/run-storybook-tests.mjs dark",
    "test:stories:visual": "playwright test --config playwright.storybook.config.ts",
    "test:stories:visual:update": "playwright test --config playwright.storybook.config.ts --update-snapshots",
    "test:browsers": "playwright test",
    "test:browsers:evidence": "WHATIUSE_BROWSER_EVIDENCE=1 playwright test",
    "test:browsers:report": "playwright show-report",
    "test:visual": "playwright test tests/browser/visual-regression.spec.ts --project=chromium",
    "test:visual:catalog": "playwright test tests/browser/full-catalog-visual.spec.ts --project=chromium",
    "test:visual:catalog:update": "playwright test tests/browser/full-catalog-visual.spec.ts --project=chromium --update-snapshots",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts --project=chromium",
    "test:a11y:evidence": "WHATIUSE_ACCESSIBILITY_EVIDENCE=1 playwright test tests/browser/accessibility.spec.ts --workers=1",
    "check:a11y:evidence": "node scripts/verify-accessibility-evidence.mjs",
    "test:pilot": "playwright test tests/browser/product-pilot.spec.ts --project=chromium",
    "build:registry:manifest": "node scripts/build-registry-manifest.mjs",
    "check:registry:manifest": "node scripts/build-registry-manifest.mjs --check",
    "build:registry:versioned": "node scripts/build-versioned-registry.mjs",
    "check:registry:versioned": "node scripts/build-versioned-registry.mjs --check",
    "diff:registry": "node scripts/diff-registry.mjs",
    "build:package": "npm run check:tokens && npm run check:api && npm run check:agent && vite build --config vite.package.config.mjs && tsc -p tsconfig.package.json && node scripts/build-package.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "test:package": "node scripts/verify-package-consumer.mjs && npm run test:react-compat && npm run test:tailwind",
    "test:package:evidence": "WHATIUSE_PACKAGE_EVIDENCE=1 node scripts/verify-package-consumer.mjs",
    "test:react-compat": "node scripts/verify-react-compat.mjs",
    "test:tailwind": "node scripts/verify-tailwind-consumer.mjs",
    "test:dogfood": "node scripts/verify-dogfood-consumer.mjs",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "test:consumer:upgrade": "node scripts/verify-registry-upgrade.mjs",
    "measure:bundle": "node scripts/measure-performance.mjs",
    "measure:runtime": "node scripts/verify-runtime-performance.mjs",
    "check:runtime-performance": "node scripts/verify-runtime-performance-evidence.mjs",
    "measure": "npm run measure:bundle && npm run measure:runtime",
    "configure:publication": "node scripts/configure-publication.mjs",
    "build:registry:style": "npm run build:tokens && npm run build:agent && node scripts/build-registry-style.mjs",
    "build:registry": "npm run build:registry:style && node scripts/clean-mutable-registry.mjs && shadcn build && npm run build:registry:manifest && npm run build:registry:versioned",
    "test:registry:structure": "node scripts/verify-registry.mjs",
    "test:quickstart": "node scripts/verify-shadcn-consumer.mjs",
    "test:quickstart:evidence": "WHATIUSE_QUICKSTART_EVIDENCE=1 node scripts/verify-shadcn-consumer.mjs",
    "test:adoption:vite": "node scripts/verify-shadcn-consumer.mjs",
    "test:adoption:next": "node scripts/verify-next-consumer.mjs",
    "test:adoption:update": "node scripts/verify-registry-upgrade.mjs",
    "test:adoption": "npm run test:adoption:vite && npm run test:adoption:next && npm run test:adoption:update",
    "test:adoption:evidence": "WHATIUSE_QUICKSTART_EVIDENCE=1 npm run test:adoption:vite && WHATIUSE_NEXT_EVIDENCE=1 npm run test:adoption:next && WHATIUSE_UPGRADE_EVIDENCE=1 npm run test:adoption:update && npm run build:adoption",
    "build:adoption": "node scripts/build-adoption-evidence.mjs",
    "check:adoption": "node scripts/build-adoption-evidence.mjs --check",
    "test:data:clean-room": "node scripts/verify-whatiuse-data-consumer.mjs",
    "test:data:clean-room:evidence": "WHATIUSE_DATA_EVIDENCE=1 node scripts/verify-whatiuse-data-consumer.mjs",
    "test:analytics:clean-room": "node scripts/verify-whatiuse-analytics-consumer.mjs",
    "test:analytics:clean-room:evidence": "WHATIUSE_ANALYTICS_EVIDENCE=1 node scripts/verify-whatiuse-analytics-consumer.mjs",
    "test:product-patterns:clean-room": "node scripts/verify-whatiuse-product-patterns-consumer.mjs",
    "test:product-patterns:clean-room:evidence": "WHATIUSE_PRODUCT_PATTERNS_EVIDENCE=1 node scripts/verify-whatiuse-product-patterns-consumer.mjs",
    "test:skill": "node scripts/verify-whatiuse-skill.mjs",
    "test:agent:eval": "node scripts/evaluate-agent-layer.mjs",
    "test:agent:eval:evidence": "WHATIUSE_AGENT_EVIDENCE=1 node scripts/evaluate-agent-layer.mjs",
    "test:agent": "npm run check:agent && npm run test:skill && npm run test:agent:eval",
    "test:agent:evidence": "npm run check:agent && npm run test:skill && npm run test:agent:eval:evidence",
    "test:registry:cli": "npm run test:quickstart",
    "test:registry": "npm run test:registry:structure && npm run test:adoption && npm run test:data:clean-room && npm run test:analytics:clean-room && npm run test:product-patterns:clean-room && npm run test:agent && npm run check:registry:history",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check:registry:history": "node scripts/verify-registry-history.mjs",
    "check:security": "node scripts/verify-security-posture.mjs && npm run check:registry:history",
    "verify:clean": "npm run check:tokens && npm run check:foundations && npm run check:api && npm run check:agent && npm run check:adoption && npm run check:freeze && npm run check:evidence && npm run check:a11y:evidence && npm run check:runtime-performance && npm run check:security && npm run test && npm run build:storybook && npm run build:registry && npm run test:registry && npm run test:consumer && npm run build:package && npm run check:package && npm run test:package && npm run test:dogfood && npm run build && npm run test:sites && npm run measure",
    "test:clean-room": "node scripts/verify-clean-room.mjs",
    "verify:rc:core": "npm run quality && npm audit --audit-level=high",
    "verify:rc": "npm run verify:rc:core && npm run test:browsers && npm run test:clean-room",
    "assemble:package-candidate": "node scripts/build-package-candidate.mjs",
    "assemble:rc": "node scripts/assemble-release-candidate.mjs",
    "quality": "npm run check:tokens && npm run check:foundations && npm run check:api && npm run check:agent && npm run check:adoption && npm run check:freeze && npm run check:evidence && npm run check:a11y:evidence && npm run check:runtime-performance && npm run check:security && npm run test && npm run test:stories && npm run build:storybook && npm run test:stories:visual && npm run test:visual:catalog && npm run build:registry && npm run test:registry && npm run test:consumer && npm run build:package && npm run check:package && npm run test:package && npm run test:dogfood && npm run build && npm run test:sites && npm run measure"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "react-aria-components": "^1.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-themes": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shadcn": "4.18.0",
    "skills": "1.5.10",
    "storybook": "^10.5.8",
    "typescript": "^7.0.2",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minwookshin/whatiuse.git"
  },
  "bugs": {
    "url": "https://github.com/minwookshin/whatiuse/issues"
  },
  "homepage": "https://whatiuse.minwookshin.com",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "author": ""
}
